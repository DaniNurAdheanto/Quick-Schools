{
  "entities": {
    "Grade": {
      "title": "Grade",
      "description": "Student grades for subjects",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 100 },
        "studentName": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["Tugas", "Ulangan", "UTS", "UAS"] },
        "score": { "type": "number" },
        "semester": { "type": "string", "maxLength": 50 },
        "academicYear": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "studentName", "subject", "type", "score", "semester", "academicYear", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "A student in the school",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "classId": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Aktif", "Lulus", "Pindah"] },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "name", "classId", "status"]
    }
    "Announcement": {
      "title": "Announcement",
      "description": "An announcement for the school",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "desc": { "type": "string", "maxLength": 2000 },
        "target": { "type": "string", "maxLength": 100 },
        "tag": { "type": "string", "maxLength": 50 },
        "author": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["Aktif", "Terjadwal", "Berakhir"] },
        "tagColor": { "type": "string", "maxLength": 100 },
        "theme": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "desc", "target", "tag", "author", "status", "tagColor", "theme", "date", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "grades/{gradeId}": {
      "schema": { "$ref": "#/entities/Grade" },
      "description": "Collection of student grades"
    },
    "students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Collection of students"
    },
    "announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Collection of announcements"
    }
  }
}
