// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. Authentication & System Users
// -------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  SAAS_ADMIN
  ADMIN
  KEPALA_SEKOLAH
  GURU
  SISWA
  ORANG_TUA
}

enum AccountStatus {
  AKTIF
  NONAKTIF
  BELUM_ONBOARDING
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String?
  name                String
  role                UserRole       @default(SISWA)
  status              AccountStatus  @default(AKTIF)
  onboardingCompleted Boolean        @default(true)
  phone               String?
  avatarUrl           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // 1-to-1 or 1-to-many profile relations
  student             Student?
  teacher             Teacher?
  parent              Parent?
  announcements       Announcement[]
  processedLeaves     LeaveRequest[] @relation("ApprovedByUser")

  @@index([role])
  @@index([email])
}

// -------------------------------------------------------------
// 2. Academic Master Data (Years, Classes, Subjects)
// -------------------------------------------------------------
model AcademicYear {
  id        String     @id @default(cuid())
  name      String     // e.g. "2025/2026"
  semester  String     // e.g. "Ganjil" | "Genap"
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean    @default(true)
  isLocked  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  classes   Class[]
  schedules Schedule[]
  grades    Grade[]
}

model Class {
  id                String       @id @default(cuid())
  name              String       // e.g. "10 MIPA 1"
  level             String       // e.g. "10", "11", "12"
  major             String?      // e.g. "MIPA", "IPS"
  academicYearId    String?
  academicYear      AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  homeroomTeacherId String?
  homeroomTeacher   Teacher?     @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)

  students          Student[]
  schedules         Schedule[]
  attendances       Attendance[]
  grades            Grade[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Subject {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. "MAT-10"
  name        String           // e.g. "Matematika Wajib"
  category    String?          // e.g. "Wajib", "Peminatan"
  level       String?          // e.g. "SMA"
  creditHours Int              @default(2)

  teachers    TeacherSubject[]
  schedules   Schedule[]
  grades      Grade[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// -------------------------------------------------------------
// 3. Teachers & Subjects Assignment
// -------------------------------------------------------------
model Teacher {
  id               String           @id @default(cuid())
  nip              String           @unique
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  gender           String?          // "Laki-laki" | "Perempuan"
  phone            String?
  address          String?
  status           String           @default("Aktif") // "Aktif", "Cuti", "Nonaktif"
  photoUrl         String?

  // Relations
  subjects         TeacherSubject[]
  homeroomForClass Class[]          @relation("HomeroomTeacher")
  schedules        Schedule[]
  attendances      TeacherAttendance[]
  leaveRequests    LeaveRequest[]
  gradesGiven      Grade[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([nip])
}

model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

// -------------------------------------------------------------
// 4. Students & Parents (Wali Murid)
// -------------------------------------------------------------
model Student {
  id             String          @id @default(cuid())
  nisn           String          @unique
  nis            String?
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  nickname       String?
  gender         String          @default("Laki-laki")
  birthPlace     String?
  birthDate      DateTime?
  religion       String?         @default("Islam")
  nik            String?
  address        String?
  phone          String?
  
  classId        String?
  class          Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  major          String?         @default("MIPA")
  entryYear      String?         @default("2025/2026")
  level          String?         @default("SMA")
  status         String          @default("Aktif")
  photoUrl       String?

  // Family Info
  fatherName     String?
  motherName     String?
  guardianName   String?
  parentPhone    String?
  parentJob      String?
  parentIncome   String?
  parentAddress  String?

  // Relations
  parents        ParentStudent[]
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  grades         Grade[]
  payments       Payment[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([nisn])
  @@index([classId])
}

model Parent {
  id           String          @id @default(cuid())
  userId       String?         @unique
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  email        String?
  phone        String?
  address      String?
  job          String?
  income       String?

  // Children relation (Many-to-Many)
  students     ParentStudent[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ParentStudent {
  id           String   @id @default(cuid())
  parentId     String
  studentId    String
  relationship String   @default("Orang Tua") // "Ayah", "Ibu", "Wali"
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

// -------------------------------------------------------------
// 5. Attendance (Presensi Siswa & Guru) & Leave Requests
// -------------------------------------------------------------
enum AttendanceStatus {
  HADIR
  TERLAMBAT
  IZIN
  SAKIT
  ALPA
}

model Attendance {
  id          String           @id @default(cuid())
  date        String           // Format "YYYY-MM-DD" e.g. "2026-10-08"
  time        String?          // e.g. "07:15"
  checkInTime DateTime?
  checkOutTime DateTime?
  status      AttendanceStatus @default(HADIR)
  notes       String?
  isFinal     Boolean          @default(false)
  photoUrl    String?
  latitude    Float?
  longitude   Float?

  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId     String?
  class       Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date])
  @@index([classId, date])
  @@index([status])
}

model TeacherAttendance {
  id          String           @id @default(cuid())
  date        String           // Format "YYYY-MM-DD"
  time        String?
  checkInTime DateTime?
  checkOutTime DateTime?
  status      AttendanceStatus @default(HADIR)
  notes       String?
  latitude    Float?
  longitude   Float?

  teacherId   String
  teacher     Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([teacherId, date])
  @@index([date])
}

enum LeaveType {
  IZIN
  SAKIT
  CUTI
  DISPENSASI
}

enum ApprovalStatus {
  PENDING
  DISETUJUI
  DITOLAK
}

model LeaveRequest {
  id          String         @id @default(cuid())
  type        LeaveType      @default(IZIN)
  startDate   DateTime
  endDate     DateTime
  reason      String
  proofUrl    String?
  status      ApprovalStatus @default(PENDING)

  studentId   String?
  student     Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     Teacher?       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  approvedById String?
  approvedBy  User?          @relation("ApprovedByUser", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt  DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([startDate, endDate])
}

// -------------------------------------------------------------
// 6. Schedule, Grades, & Finance
// -------------------------------------------------------------
model Schedule {
  id             String        @id @default(cuid())
  dayOfWeek      Int           // 1 = Senin, 2 = Selasa, ..., 6 = Sabtu
  startTime      String        // "07:30"
  endTime        String        // "09:00"
  room           String?       // "R. 101"

  classId        String
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Grade {
  id             String        @id @default(cuid())
  type           String        // "Tugas 1", "UH 1", "UTS", "UAS", "Raport"
  score          Float
  notes          String?

  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId        String?
  class          Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacherId      String?
  teacher        Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([studentId, subjectId])
}

enum PaymentStatus {
  LUNAS
  PENDING
  BELUM_BAYAR
  DIBATALKAN
}

model Payment {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  title         String        // e.g. "SPP Oktober 2026"
  amount        Float
  status        PaymentStatus @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  paymentMethod String?       // "Transfer Bank", "Tunai", "QRIS"
  receiptUrl    String?

  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  targetRole  String   @default("Semua") // "Semua", "Guru", "Siswa", "Orang Tua"
  isPinned    Boolean  @default(false)

  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 7. SaaS School Subscription Requests
// -------------------------------------------------------------
enum SubscriptionRequestStatus {
  PENDING
  CONTACTED
  OFFER_SENT
  APPROVED
  REJECTED
}

model SubscriptionRequest {
  id              String                    @id @default(cuid())
  requestNumber   String                    @unique // e.g. "REQ-SUB-2026-123456"
  schoolName      String
  npsn            String?
  schoolLevel     String                    // "TK/PAUD", "SD/MI", "SMP/MTs", "SMA/MA", "SMK", "Pesantren/Yayasan"
  schoolType      String?                   @default("Swasta") // "Swasta" | "Negeri"
  province        String?
  city            String?
  address         String?
  subdomain       String?

  // Penanggung Jawab (PIC)
  picName         String
  picRole         String                    // "Kepala Sekolah", "Wakil Kepala Sekolah", "Ketua Yayasan", "Bendahara", "Koordinator IT", "Staf TU"
  picEmail        String
  picPhone        String                    // Nomor WhatsApp

  // Skala & Layanan yang Diminati
  studentCount    Int?                      // e.g. 450
  studentEstimate String?                   // e.g. "300 - 600"
  planInterest    String                    // "trial" | "standard" | "pro" | "enterprise"
  selectedModules String[]                  // e.g. ["mod_presensi", "mod_keuangan", "mod_rapor"]
  notes           String?
  preferredTime   String?                   // e.g. "Pagi (09:00 - 12:00)", "Siang (13:00 - 16:00)", "WhatsApp Saja"

  // Follow-Up & Tindak Lanjut Admin
  status          SubscriptionRequestStatus @default(PENDING)
  followUpNotes   String?
  assignedTo      String?
  quotedPrice     Float?
  contactedAt     DateTime?

  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  customer        SaaSCustomer?

  @@index([status])
  @@index([picEmail])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 8. SaaS Customers (Pelanggan Sekolah Quick Schools)
// -------------------------------------------------------------
enum SaaSCustomerStatus {
  AKTIF
  TRIAL
  SUSPENDED
  NONAKTIF
}

model SaaSCustomer {
  id                    String              @id @default(cuid())
  customerCode          String              @unique // e.g. "CUST-2026-001"
  schoolName            String
  npsn                  String?
  subdomain             String?             @unique
  schoolLevel           String              // "TK/PAUD", "SD/MI", "SMP/MTs", "SMA/MA", "SMK", "Pesantren/Yayasan"
  schoolType            String?             @default("Swasta") // "Swasta" | "Negeri"
  address               String?
  city                  String?
  province              String?
  logoUrl               String?

  // Penanggung Jawab (PIC)
  picName               String
  picRole               String
  picEmail              String
  picPhone              String

  // Layanan & Langganan
  plan                  String              @default("pro") // "trial" | "standard" | "pro" | "enterprise"
  status                SaaSCustomerStatus  @default(AKTIF)
  billingCycle          String              @default("MONTHLY") // "MONTHLY" | "YEARLY"
  priceAmount           Float               @default(199000)
  maxStudents           Int                 @default(1000)
  currentStudents       Int                 @default(0)
  activeModules         String[]            @default([])
  subscriptionStart     DateTime            @default(now())
  subscriptionEnd       DateTime?

  notes                 String?

  // Relasi jika pelanggan berasal dari Permintaan Berlangganan
  subscriptionRequestId String?             @unique
  subscriptionRequest   SubscriptionRequest? @relation(fields: [subscriptionRequestId], references: [id], onDelete: SetNull)

  invoices              SaaSInvoice[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([plan])
  @@index([picEmail])
  @@index([schoolName])
}

// -------------------------------------------------------------
// 9. SaaS Service Packages (Katalog Paket Layanan SaaS)
// -------------------------------------------------------------
model SaaSPackage {
  id              String   @id @default(cuid())
  code            String   @unique // "trial", "standard", "pro", "enterprise"
  name            String   // "Sekolah Unggulan (Pro)"
  tagline         String?  // "Otomasi lengkap untuk sekolah modern"
  badge           String?  // "Paling Populer"
  priceMonthly    Float    @default(0)
  priceYearly     Float    @default(0)
  maxStudents     Int      @default(500)
  features        String[] @default([])
  isActive        Boolean  @default(true)
  isPopular       Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// -------------------------------------------------------------
// 10. SaaS Invoices & Payments (Tagihan & Pembayaran Langganan)
// -------------------------------------------------------------
enum SaaSInvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

model SaaSInvoice {
  id            String            @id @default(cuid())
  invoiceNumber String            @unique // e.g. "INV-SAAS-2026-001"
  customerId    String
  customer      SaaSCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  schoolName    String
  plan          String            // "standard" | "pro" | "enterprise"
  amount        Float
  billingCycle  String            @default("MONTHLY") // "MONTHLY" | "YEARLY"
  status        SaaSInvoiceStatus @default(UNPAID)
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?           // "TRANSFER_BANK", "VIRTUAL_ACCOUNT", "QRIS", "MANUAL"
  paymentProof  String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([dueDate])
}

// -------------------------------------------------------------
// 11. SaaS Operational Audit Log (Log Aktivitas Operasional SaaS)
// -------------------------------------------------------------
model SaaSOperationLog {
  id          String   @id @default(cuid())
  action      String   // "STATUS_CHANGE", "CUSTOMER_CREATED", "INVOICE_PAID", "REQUEST_FOLLOWUP"
  entityType  String   // "CUSTOMER", "REQUEST", "INVOICE", "PACKAGE"
  entityId    String?
  entityName  String?
  description String
  performedBy String   // Name or email of SaaS Administrator
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}



