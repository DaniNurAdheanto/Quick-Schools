rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /roles/{roleId} {
      allow read, write: if isSignedIn();
    }

    match /user_menu_reads/{userId} {
      allow read, write: if isSignedIn();
    }

    match /deleted_accounts/{deletedId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /parents/{parentId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reportCards/{cardId} {
      allow read, write: if isSignedIn();
    }
    
    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'classId', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.classId is string && data.classId.size() > 0 && data.classId.size() <= 50
        && data.status is string && data.status in ['Aktif', 'Nonaktif', 'Lulus', 'Pindah']
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500));
    }

    function isValidGrade(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'subject', 'type', 'score', 'semester', 'academicYear', 'createdAt', 'updatedAt'])
        && data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 100
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 100
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100
        && data.type is string && data.type in ['Tugas', 'Ulangan', 'UTS', 'UAS']
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.semester is string && data.semester.size() > 0 && data.semester.size() <= 50
        && data.academicYear is string && data.academicYear.size() > 0 && data.academicYear.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /students/{studentId} {
      allow read, write: if isSignedIn();
    }
    
    match /grades/{gradeId} {
      allow read, write: if isSignedIn();
    }
    
    match /announcements/{announcementId} {
      allow read, write: if isSignedIn();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /subject_groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /calendar_events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /examSchedules/{examId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /examGroups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      // Only allow creating new records (not overwriting existing ones) — enforces one attendance per day
      allow create: if isSignedIn();
      // Updates only allowed if the record belongs to the same user or by admin
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        (resource.data.studentEmail != null && resource.data.studentEmail == request.auth.token.email)
      );
      allow delete: if isSignedIn();
    }
    match /teacher_attendance/{recordId} {
      allow read: if isSignedIn();
      // Only allow creating new records — prevents overwriting existing clock-in data
      allow create: if isSignedIn();
      // Updates allowed for clock-out (same teacher) or by admin
      allow update: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid ||
        (resource.data.email != null && resource.data.email == request.auth.token.email)
      );
      allow delete: if isSignedIn();
    }
    match /attendance_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    // SPP Payments & Financial Management
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      // Only Admin / Financial Staff can create, update, or delete payments; Teachers, Students, and Kepala Sekolah are strictly read-only
      allow write: if isSignedIn() && (
        request.auth.token.role != 'siswa' && 
        request.auth.token.role != 'guru' &&
        request.auth.token.role != 'student' &&
        request.auth.token.role != 'teacher' &&
        request.auth.token.role != 'kepala-sekolah' &&
        request.auth.token.role != 'kepsek' &&
        request.auth.token.role != 'principal'
      );
    }
    match /spp_rates/{rateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.token.role != 'siswa' && 
        request.auth.token.role != 'guru' &&
        request.auth.token.role != 'kepala-sekolah' &&
        request.auth.token.role != 'kepsek' &&
        request.auth.token.role != 'principal'
      );
    }
    match /payment_activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
