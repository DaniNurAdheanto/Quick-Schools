rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'classId', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.classId is string && data.classId.size() > 0 && data.classId.size() <= 50
        && data.status is string && data.status in ['Aktif', 'Lulus', 'Pindah']
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500));
    }
    
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
                    && isValidId(studentId)
                    && isValidStudent(incoming())
                    && incoming().keys().size() <= 5;
      allow update: if isSignedIn()
                    && isValidId(studentId)
                    && isValidStudent(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['id', 'name', 'classId', 'status', 'imageUrl']);
      allow delete: if isSignedIn() && isValidId(studentId);
    }
  }
}
